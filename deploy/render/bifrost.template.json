            "weight": 1.0
          }
        ],
        "fallbacks": [
          "vertex",
          "openrouter"
        ],
        "enabled": true,
        "scope": "global",
        "priority": 13
      },
      {
        "id": "rule-deepseek-v4-pro-fallback",
