    "routing_rules": [
      {
        "id": "rule-complexity-pilot-simple",
        "name": "pilot: SIMPLE tier -> fast cheap model",
        "cel_expression": "complexity_tier == \"SIMPLE\"",
        "targets": [
          {
            "provider": "vertex",
            "model": "google/gemini-3.7-flash",
            "weight": 1.0
          }
        ],
        "enabled": true,
        "priority": 1,
        "scope": "virtual_key",
        "scope_id": "vk-interactive-complexity-pilot"
      },
      {
        "id": "rule-complexity-pilot-medium",
        "name": "pilot: MEDIUM tier -> balanced model",
        "cel_expression": "complexity_tier == \"MEDIUM\"",
        "targets": [
          {
            "provider": "azure",
            "model": "gpt-5.6-terra",
            "weight": 1.0
          }
        ],
        "enabled": true,
        "priority": 2,
        "scope": "virtual_key",
        "scope_id": "vk-interactive-complexity-pilot"
      },
      {
        "id": "rule-complexity-pilot-complex",
        "name": "pilot: COMPLEX tier -> strong general model",
        "cel_expression": "complexity_tier == \"COMPLEX\"",
        "targets": [
          {
            "provider": "azure",
            "model": "gpt-5.6-sol",
            "weight": 1.0
          }
        ],
        "enabled": true,
        "priority": 3,
        "scope": "virtual_key",
        "scope_id": "vk-interactive-complexity-pilot"
      },
      {
        "id": "rule-complexity-pilot-reasoning",
        "name": "pilot: REASONING tier -> frontier model",
        "cel_expression": "complexity_tier == \"REASONING\"",
        "targets": [
          {
            "provider": "bedrock",
            "model": "anthropic/claude-opus-5",
            "weight": 1.0
          }
        ],
        "enabled": true,
        "priority": 4,
        "scope": "virtual_key",
        "scope_id": "vk-interactive-complexity-pilot"
      },
      {
        "id": "rule-claude-sonnet-5-fallback",
        "name": "Claude Sonnet 5 (Vertex -> Bedrock fallback)",
        "cel_expression": "model == \"claude-sonnet-5\" || model == \"anthropic/claude-sonnet-5\" || model == \"bedrock/anthropic/claude-sonnet-5\"",
        "targets": [
          {
            "provider": "vertex",
            "model": "claude-sonnet-5",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "bedrock",
          "openrouter"
        ],
        "enabled": true,
        "scope": "global",
        "priority": 11
      },
      {
        "id": "rule-claude-opus-5-fallback",
        "name": "Claude Opus 5 (Vertex -> Bedrock fallback)",
        "cel_expression": "model == \"claude-opus-5\" || model == \"anthropic/claude-opus-5\" || model == \"bedrock/anthropic/claude-opus-5\"",
        "targets": [
          {
            "provider": "vertex",
            "model": "claude-opus-5",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "bedrock",
          "openrouter"
        ],
        "enabled": true,
        "scope": "global",
        "priority": 12
      },
      {
        "id": "rule-claude-fable-5-fallback",
        "name": "Claude Fable 5 (Bedrock primary \u2014 Vertex fable quota pending)",
