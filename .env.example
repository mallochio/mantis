# Required: OpenRouter API key. LiteLLM proxy and the fugu workers run through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Required for llm-router's internal mf scorer (text-embedding-3-small only).
OPENAI_API_KEY=sk-replace-me

# Optional: internal auth token for router/openfugu -> LiteLLM proxy
LITELLM_KEY=sk-fugu-local

# --- Router (llm-router :5500) ---
# Model names must be in configs/litellm.yaml. They are OpenRouter ids aliased
# to Anthropic models that sit on the code/cost Pareto frontier and are available
# on AWS Bedrock, GCP, and Azure via OpenRouter.
EXPENSIVE_MODEL=claude-opus-4.8
CHEAP_MODEL=claude-sonnet-5

# --- OpenFugu orchestrator (:8088) ---
# TRINITY router backbone (Qwen3-0.6B). It is small and safe to run locally even on a Mac.
FUGU_MODEL=Qwen/Qwen3-0.6B
FUGU_VECTOR=/app/artifacts/model_iter_60.npy

# Optional: a 10240-float per-step head override (.npy or .safetensors)
# FUGU_HEAD=/app/artifacts/router_head.npy

# Worker pool CSV. Order matters: it becomes slot ids 0..n-1 for the Conductor.
# The default 7-slot pool below is the code/cost Pareto set on AWS/GCP/Azure.
FUGU_WORKER_MODEL=claude-sonnet-5
FUGU_WORKER_MODELS=claude-haiku-4.5,claude-sonnet-5,claude-sonnet-4.6,claude-sonnet-4.5,claude-opus-4.8,claude-opus-5,claude-fable-5

# Conductor planning model (LiteLLM alias). For cheaper planning use claude-sonnet-5;
# for strongest planning use claude-opus-4.8 or claude-fable-5.
FUGU_CONDUCTOR_MODEL=claude-opus-4.8

# Set to a HuggingFace id/path to load a local Llama-3.2-3B Conductor instead of LiteLLM.
# FUGU_LOCAL_CONDUCTOR=di-zhang-fdu/openfugu-conductor-3b

# Local Conductor inference options (only used when FUGU_LOCAL_CONDUCTOR is set)
FUGU_CONDUCTOR_DEVICE=cpu
FUGU_CONDUCTOR_DTYPE=float32
FUGU_CONDUCTOR_MAX_NEW=512

# Max turns for TRINITY loop
FUGU_MAX_TURNS=5

# --- Pi /fugu extension ---
FUGU_URL=http://127.0.0.1:8088/v1
FUGU_ROUTER_URL=http://127.0.0.1:5500/v1
FUGU_API_KEY=sk-fugu-local
# Score threshold: <=2 fall through to normal Pi; 3 -> trinity; >=4 -> conductor.
FUGU_AUTO_THRESHOLD=4

# HuggingFace token (optional, but avoids HF rate limits and is required for gated checkpoints)
# HF_TOKEN=hf_...
