# Required: OpenRouter API key. LiteLLM proxy and the fugu workers run through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional: OpenCode Go key. Only needed if you use the opencode-* aliases in FUGU_WORKER_MODELS.
# OPENCODE_GO_API_KEY=sk-...

# Required for llm-router's internal mf scorer (text-embedding-3-small only).
OPENAI_API_KEY=sk-replace-me

# Optional: internal auth token for router/openfugu -> LiteLLM proxy
LITELLM_KEY=sk-fugu-local

# --- Router (llm-router :5500) ---
# Model names must be in configs/litellm.yaml. They are LiteLLM aliases that route
# to OpenRouter model ids with the right reasoning effort.
EXPENSIVE_MODEL=gpt-5.6-sol-medium
CHEAP_MODEL=gpt-5.6-luna-max

# Leave empty so the LiteLLM alias (configs/litellm.yaml) controls reasoning_effort.
# If you set these, the router will override the alias value for every backend.
EXPENSIVE_REASONING_EFFORT=
CHEAP_REASONING_EFFORT=

# --- OpenFugu orchestrator (:8088) ---
# TRINITY router backbone (Qwen3-0.6B). It is small and safe to run locally even on a Mac.
FUGU_MODEL=Qwen/Qwen3-0.6B
FUGU_VECTOR=/app/artifacts/model_iter_60.npy

# Optional: a 10240-float per-step head override (.npy or .safetensors)
# FUGU_HEAD=/app/artifacts/router_head.npy

# Worker pool CSV. Order matters: it becomes slot ids 0..n-1 for the Conductor.
# The default 7-slot pool below is the requested code/cost frontier mix.
FUGU_WORKER_MODEL=claude-sonnet-5-medium
FUGU_WORKER_MODELS=gemini-3.6-flash-high,gpt-5.6-luna-max,gpt-5.6-sol-medium,deepseek-v4-flash-0731-xhigh,claude-opus-5-medium,claude-sonnet-5-medium,gemini-3.1-pro-preview-high

# Conductor planning model (LiteLLM alias). gpt-5.6-luna-max follows the
# three-list workflow format reliably in testing; claude-opus-5-medium tends
# to answer directly instead of emitting a DAG.
FUGU_CONDUCTOR_MODEL=gpt-5.6-luna-max

# Set to a HuggingFace id/path to load a local Llama-3.2-3B Conductor instead of LiteLLM.
# FUGU_LOCAL_CONDUCTOR=di-zhang-fdu/openfugu-conductor-3b

# Local Conductor inference options (only used when FUGU_LOCAL_CONDUCTOR is set)
FUGU_CONDUCTOR_DEVICE=cpu
FUGU_CONDUCTOR_DTYPE=float32
FUGU_CONDUCTOR_MAX_NEW=512

# Max turns for TRINITY loop
FUGU_MAX_TURNS=5

# --- Pi /fugu extension ---
FUGU_URL=http://127.0.0.1:8088/v1
FUGU_ROUTER_URL=http://127.0.0.1:5500/v1
FUGU_API_KEY=sk-fugu-local
# Score threshold: <=2 fall through to normal Pi; 3 -> trinity; >=4 -> conductor.
# Conductor is currently disabled by default because the local checkpoints still
# fail to emit parseable DAGs on most prompts; set to 4 only after native GPU
# validation shows it beats trinity.
FUGU_AUTO_THRESHOLD=6

# HuggingFace token (optional, but avoids HF rate limits and is required for gated checkpoints)
# HF_TOKEN=hf_...
