# Required: API key for the LiteLLM proxy and any OpenAI-compatible workers it calls.
# This single key is the internal bearer token the router/openfugu services use.
OPENAI_API_KEY=sk-replace-me

# Optional: auth token used inside the fugu-local stack (router -> litellm, openfugu -> litellm)
LITELLM_KEY=sk-fugu-local

# --- Router (llm-router :5500) ---
# Which models the Supra complexity gate routes to. Must have matching entries in configs/litellm.yaml.
EXPENSIVE_MODEL=gpt-4o
CHEAP_MODEL=gpt-4o-mini

# --- OpenFugu orchestrator (:8088) ---
# TRINITY router backbone (Qwen3-0.6B). It is small and safe to run locally even on a Mac.
FUGU_MODEL=Qwen/Qwen3-0.6B
FUGU_VECTOR=/app/artifacts/model_iter_60.npy

# Optional: a 10240-float per-step head (.npy or .safetensors). Overrides the head in FUGU_VECTOR.
# FUGU_HEAD=/app/artifacts/router_head.npy

# Worker pool used by TRINITY and Conductor executor. CSV of litellm model ids.
# The same list is used for both coordinators; each slot can be a different model/provider.
FUGU_WORKER_MODEL=openai/gpt-4o-mini
FUGU_WORKER_MODELS=openai/gpt-4o-mini

# Local HF worker models (CSV, optional). Overrides the LiteLLM worker pool.
# Format: "path/to/model1,path/to/model2@mps". Useful for running fully offline on a Mac.
# FUGU_LOCAL_MODELS=/path/to/Llama-3.2-3B-Instruct

# Conductor planning model. LiteLLM id by default; for the real OpenFugu Conductor set FUGU_LOCAL_CONDUCTOR.
FUGU_CONDUCTOR_MODEL=openai/gpt-4o-mini

# Set to a HuggingFace id or local path to load the Llama-3.2-3B GRPO Conductor directly.
# On a Mac inside Docker this will be CPU-only; set FUGU_CONDUCTOR_DEVICE and FUGU_CONDUCTOR_DTYPE accordingly.
# FUGU_LOCAL_CONDUCTOR=di-zhang-fdu/openfugu-conductor-3b

# Conductor local model inference options.
# Use "cpu" in Docker on Mac; "mps" only works when running Python natively outside Docker.
FUGU_CONDUCTOR_DEVICE=cpu
FUGU_CONDUCTOR_DTYPE=float32
FUGU_CONDUCTOR_MAX_NEW=512

# Max turns for TRINITY loop.
FUGU_MAX_TURNS=5

# --- Pi /fugu extension ---
FUGU_URL=http://127.0.0.1:8088/v1
FUGU_ROUTER_URL=http://127.0.0.1:5500/v1
FUGU_API_KEY=sk-fugu-local
# Score threshold: <=2 fall through to normal Pi; 3 -> trinity; >=4 -> conductor.
FUGU_AUTO_THRESHOLD=4

# HuggingFace token (optional, but avoids rate limits and is required for gated checkpoints).
# HF_TOKEN=hf_...
