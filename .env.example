# Public endpoint authentication (required).
MANTIS_API_KEY=sk-mantis-replace-me
MANTIS_ROUTER_KEY=sk-route-replace-me
MANTIS_MODEL_NAME=mantis
MANTIS_HOST=127.0.0.1
MANTIS_PORT=8088

# Local Bifrost control, dashboard and complexity-pilot keys.
# Bifrost virtual keys must start with sk-bf-.
BIFROST_API_KEY=sk-bf-replace-me
BIFROST_ENCRYPTION_KEY=replace-with-64-hex-characters
BIFROST_ADMIN_USERNAME=admin
BIFROST_ADMIN_PASSWORD=replace-with-a-strong-password
BIFROST_COMPLEXITY_PILOT_KEY=sk-bf-replace-me
BIFROST_HOST=127.0.0.1
BIFROST_PORT=8080

# Direct profile credentials (the default endpoint profile).
OPENROUTER_API_KEY=sk-or-v1-replace-me
# OPENCODE_API_KEY=sk-replace-me

# Optional Cloudflare profile credential. The launcher maps this one token to
# both provider API key variables. AI_GATEWAY_API_KEY is also accepted.
# MANTIS_GATEWAY_API_KEY=replace-me

# Optional direct-profile URL overrides.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENCODE_GO_ENDPOINT_URL=https://opencode.ai/zen/go/v1

# Optional Cloudflare-profile overrides. Generic direct URL variables above are
# intentionally ignored by this profile. MANTIS_GATEWAY_URL changes both;
# provider-specific values take priority over the shared value.
# MANTIS_GATEWAY_URL=https://unified-ai-gateway.siddsantham.workers.dev/v1
# MANTIS_GATEWAY_OPENROUTER_URL=https://router-gateway.example/v1
# MANTIS_GATEWAY_OPENCODE_URL=https://opencode-gateway.example/v1

# Trained TRINITY router.
MANTIS_MODEL=Qwen/Qwen3-0.6B
MANTIS_VECTOR=./artifacts/model_iter_60.npy
# MANTIS_HEAD=./artifacts/router_head.safetensors

# The shared routing catalog (~/.config/ai-routing/catalog.toml) is the source
# of truth for worker slots and the conductor model. MANTIS_WORKER_MODELS is
# derived from the catalog by scripts/model_catalog.py render.

# Optional local models.
# MANTIS_LOCAL_MODELS=/models/worker-a@cuda:0,/models/worker-b@cuda:1
# MANTIS_LOCAL_CONDUCTOR=di-zhang-fdu/openfugu-conductor-3b
MANTIS_CONDUCTOR_DEVICE=cpu
MANTIS_CONDUCTOR_DTYPE=float32
# Optional coordinator/router backbone dtype; float32 is safest on local CPU.
MANTIS_ROUTER_DTYPE=float32
MANTIS_CONDUCTOR_MAX_NEW=512

# Runtime bounds.
MANTIS_MAX_TURNS=5
MANTIS_WORKER_TIMEOUT=240
MANTIS_RUN_TTL=600
MANTIS_RUN_STORE=file
# Set MANTIS_RUN_STORE=redis when running the optional Redis compose profile.
# MANTIS_REDIS_URL=redis://redis:6379/0
# MANTIS_REDIS_PREFIX=mantis:run:
MANTIS_MAX_CONCURRENT_RUNS=32
MANTIS_MAX_CONCURRENT_REQUESTS=32
MANTIS_SSE_KEEPALIVE_SECONDS=10
MANTIS_STREAM_EVENTS=1
MANTIS_FINAL_CHUNK_DELAY_MS=5
MANTIS_MAX_TOOL_ROUNDS_PER_STEP=8
MANTIS_MAX_BODY_BYTES=52428800

# Optional local learning.
MANTIS_LEARNING=0
MANTIS_LEARNING_MIN_RUNS=50
MANTIS_LEARNING_MIN_IMPROVEMENT=0.02
MANTIS_LEARNING_INTERVAL=300

# Optional Hugging Face credentials/cache.
# HF_TOKEN=hf-replace-me
