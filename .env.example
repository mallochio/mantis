# Mantis — local env template (copy to .env, fill provider keys)
MANTIS_API_KEY=sk-...                # required: local Mantis API key
OPENROUTER_API_KEY=sk-or-...         # required: OpenRouter (openrouter/* models)
OPENCODE_API_KEY=sk-...              # optional: opencode-go subscription (deepseek etc.)

# Optional URL overrides (defaults: https://openrouter.ai/api/v1, https://opencode.ai/zen/go/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENCODE_GO_ENDPOINT_URL=https://opencode.ai/zen/go/v1

# Trained TRINITY router (optional)
MANTIS_MODEL=Qwen/Qwen3-0.6B
MANTIS_VECTOR=./artifacts/model_iter_60.npy
MANTIS_CONDUCTOR_DEVICE=cpu
MANTIS_CONDUCTOR_DTYPE=float32
MANTIS_ROUTER_DTYPE=float32

# Runtime bounds (defaults shown)
MANTIS_MAX_TURNS=5
MANTIS_WORKER_TIMEOUT=240
MANTIS_RUN_TTL=600
MANTIS_RUN_STORE=file                 # file | redis | memory
MANTIS_MAX_CONCURRENT_RUNS=32
MANTIS_MAX_CONCURRENT_REQUESTS=32

# Prompt-cache tuning (defaults shown)
# MANTIS_CACHE_BREAKPOINTS=1          # 1 keeps Anthropic/OpenAI markers for base/fusion
# MANTIS_BASE_SALT_SESSION=0          # 0 preserves prefix cache on escalation, still promotes to capable
# MANTIS_BASE_ESCALATE_REPEATS=3      # identical tool/error repeats before capable promotion

# Optional: local learning / HF cache
# MANTIS_LEARNING=0
# HF_TOKEN=hf-...
