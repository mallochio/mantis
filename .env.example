# Required: OpenRouter API key. LiteLLM proxy and the mantis workers run through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional: OpenCode Go key. Only needed if you use the opencode-* aliases in MANTIS_WORKER_MODELS.
# OPENCODE_GO_API_KEY=sk-...

# Required for llm-router's internal mf scorer (text-embedding-3-small only).
OPENAI_API_KEY=sk-replace-me

# Required: shared internal bearer token for the LiteLLM proxy and mantis orchestrator.
# All services and the pi extension must use the same value.
LITELLM_KEY=sk-mantis
MANTIS_API_KEY=${LITELLM_KEY}
# Keep upstream LiteLLM auth separate if MANTIS_API_KEY is a different ingress key.
MANTIS_LITELLM_API_KEY=${LITELLM_KEY}

# --- Router (llm-router :5500) ---
# Model names must be in configs/litellm.yaml. They are LiteLLM aliases that route
# to OpenRouter model ids with the right reasoning effort.
EXPENSIVE_MODEL=gpt-5.6-sol-medium
CHEAP_MODEL=gpt-5.6-luna-max

# Leave empty so the LiteLLM alias (configs/litellm.yaml) controls reasoning_effort.
# If you set these, the router will override the alias value for every backend.
EXPENSIVE_REASONING_EFFORT=
CHEAP_REASONING_EFFORT=

# --- Mantis orchestrator (:8088) ---
# TRINITY router backbone (Qwen3-0.6B). It is small and safe to run locally even on a Mac.
MANTIS_MODEL=Qwen/Qwen3-0.6B
MANTIS_VECTOR=/app/artifacts/model_iter_60.npy

# Optional: a 10240-float per-step head override (.npy or .safetensors)
# MANTIS_HEAD=/app/artifacts/router_head.npy

# Worker pool CSV. Order matters: it becomes slot ids 0..n-1 for the Conductor.
# The default 7-slot pool below is the requested code/cost frontier mix.
MANTIS_WORKER_MODEL=claude-sonnet-5-medium
MANTIS_WORKER_MODELS=gemini-3.6-flash-high,gpt-5.6-luna-max,gpt-5.6-sol-medium,deepseek-v4-flash-0731-xhigh,claude-opus-5-medium,claude-sonnet-5-medium,gemini-3.1-pro-preview-high

# Conductor planning model (LiteLLM alias). gpt-5.6-luna-max follows the
# three-list workflow format reliably in testing.
MANTIS_CONDUCTOR_MODEL=gpt-5.6-luna-max

# Set to a HuggingFace id/path to load a local Llama-3.2-3B Conductor instead of LiteLLM.
# MANTIS_LOCAL_CONDUCTOR=di-zhang-fdu/openfugu-conductor-3b

# Local Conductor inference options (only used when MANTIS_LOCAL_CONDUCTOR is set)
MANTIS_CONDUCTOR_DEVICE=cpu
MANTIS_CONDUCTOR_DTYPE=float32
MANTIS_CONDUCTOR_MAX_NEW=512

# Max turns for TRINITY loop
MANTIS_MAX_TURNS=5

# Optional zero-touch local router learning. Enabling this stores redacted task text
# and outcome metadata locally, then promotes only candidates that improve on a held-out split.
MANTIS_LEARNING=0
# Native and Docker runs default to the same host-visible directory.
# MANTIS_LEARNING_DIR=~/.local/share/mantis/learning
# MANTIS_LEARNING_HOST_DIR=~/.local/share/mantis/learning
MANTIS_LEARNING_MIN_RUNS=50
MANTIS_LEARNING_MIN_IMPROVEMENT=0.02
MANTIS_LEARNING_INTERVAL=300

# LiteLLM worker call timeout in seconds (default 240)
MANTIS_WORKER_TIMEOUT=240

# --- Pi /mantis extension ---
MANTIS_URL=http://127.0.0.1:8088/v1
MANTIS_ROUTER_URL=http://127.0.0.1:5500/v1
MANTIS_AUTO_THRESHOLD=6
# Advertised Mantis context window in tokens (default 256000). Set to the smallest effective worker window.
MANTIS_CONTEXT_WINDOW=256000

# HuggingFace token (optional, but avoids HF rate limits and is required for gated checkpoints)
# HF_TOKEN=hf_...
